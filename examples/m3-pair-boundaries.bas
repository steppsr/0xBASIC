CONTRACT PairHeight(config AS PAIR OF (INTEGER, BOOLEAN))
    SOLUTION payload AS PAIR OF (STRING, BYTES)
    IF REST(config) THEN
        EMIT ASSERT_HEIGHT_ABSOLUTE(FIRST(config) + Size(payload))
    END IF
END CONTRACT

FUNCTION Size(value AS PAIR OF (STRING, BYTES)) AS INTEGER
    RETURN BYTE_LENGTH(UTF8(FIRST(value))) + BYTE_LENGTH(REST(value))
END FUNCTION
