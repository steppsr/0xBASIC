CONTRACT DomainBoundary(recipient AS PUZZLEHASH, limit AS AMOUNT)
SOLUTION request AS PAIR OF (PUZZLEHASH, LIST OF AMOUNT)
ASSERT FIRST(request) = recipient
DIM values AS LIST OF AMOUNT = REST(request)
DIM chosen AS AMOUNT = FIRST(values)
ASSERT AMOUNT_VALUE(chosen) <= AMOUNT_VALUE(limit)
DIM copied AS PUZZLEHASH = AS_PUZZLEHASH(HASH_BYTES(recipient))
ASSERT copied = recipient
EMIT ASSERT_HEIGHT_ABSOLUTE(ToHeight(chosen))
END CONTRACT

FUNCTION ToHeight(value AS AMOUNT) AS INTEGER
RETURN AMOUNT_VALUE(AS_AMOUNT(AMOUNT_VALUE(value)))
END FUNCTION
