CONTRACT KeyBoundary(owner AS PUBLICKEY)
SOLUTION candidates AS LIST OF PAIR OF (PUBLICKEY, AMOUNT)
DIM candidate AS PUBLICKEY = FIRST(FIRST(candidates))
ASSERT candidate = owner
ASSERT RoundTrip(candidate) = owner
EMIT ASSERT_HEIGHT_ABSOLUTE(AMOUNT_VALUE(REST(FIRST(candidates))))
END CONTRACT

FUNCTION RoundTrip(key AS PUBLICKEY) AS PUBLICKEY
RETURN AS_PUBLICKEY(KEY_BYTES(key))
END FUNCTION
