CONTRACT HashFixture()
    CONST message AS BYTES = 0x616263
    DIM digest AS BYTES = Hash(message)
    ASSERT digest = 0xba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    EMIT ASSERT_HEIGHT_ABSOLUTE(BYTE_LENGTH(digest))
END CONTRACT

FUNCTION Hash(message AS BYTES) AS BYTES
    RETURN SHA256(message)
END FUNCTION
