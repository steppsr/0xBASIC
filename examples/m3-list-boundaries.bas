CONTRACT ListHeight(config AS LIST OF PAIR OF (INTEGER, BOOLEAN))
    SOLUTION items AS LIST OF PAIR OF (STRING, BYTES)
    DIM saved = items
    IF LIST_LENGTH(config) > 0 AND LIST_LENGTH(saved) > 0 THEN
        IF REST(FIRST(config)) THEN
            EMIT ASSERT_HEIGHT_ABSOLUTE(FIRST(FIRST(config)) + Size(FIRST(saved)))
        END IF
    END IF
END CONTRACT

FUNCTION Size(item AS PAIR OF (STRING, BYTES)) AS INTEGER
    RETURN BYTE_LENGTH(UTF8(FIRST(item))) + BYTE_LENGTH(REST(item))
END FUNCTION
